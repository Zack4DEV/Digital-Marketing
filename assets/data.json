import json
import streamlit as st

def load_ai_config():
    """Loads AI configuration from assets/data.json."""
    try:
        with open('assets/data.json', 'r') as f:
            config = json.load(f)
        return config
    except FileNotFoundError:
        st.error("assets/data.json not found.")
        return None
    except json.JSONDecodeError:
        st.error("Invalid JSON format in assets/data.json.")
        return None

ai_config = load_ai_config()

if ai_config:
    ai_platform = ai_config.get('ai_platform')

    if ai_platform == 'mendable':
        mendable_config = ai_config.get('mendable')
        if mendable_config:
            mendable_api_key = mendable_config.get('api_key')
            mendable_workspace_id = mendable_config.get('workspace_id')
            mendable_data_source_id = mendable_config.get('data_source_id')
            mendable_model = mendable_config.get('model')

            # Use these variables to configure your Mendable AI client
            # ...
        else:
            st.error("Mendable configuration missing in assets/data.json.")

    elif ai_platform == 'other':
      other_ai_config = ai_config.get('other_ai')
      if other_ai_config:
            other_api_key = other_ai_config.get('other_api_key')
            other_model = other_ai_config.get('other_model')
            #use other ai config
      else:
            st.error("Other AI configuration missing in assets/data.json.")
    else:
        st.error("Invalid ai_platform in assets/data.json.")